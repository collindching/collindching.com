---
// Hand-built diagram per inspiration entry, in the vein of The Brain Lab Co:
// metaphor-first, contrast-driven, annotated — not boxes-and-arrows.
//
// Anti-AI-tell rules: nothing centered-and-even, labels annotate instead of
// titling, color encodes meaning (brown = the human intervention,
// faint = raw noise), every mark earns its place.
interface Props {
  id: string;
}
const { id } = Astro.props;
const SERIF = "Georgia, 'Times New Roman', serif";
---

{id === "brain-lab" && (
  <svg viewBox="0 0 380 190" role="img" aria-label="Diagram: a dense paper contrasted with its one-sentence translation">
    <defs>
      <marker id="arr-brown" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" fill="var(--accent)" />
      </marker>
    </defs>

    <text x="20" y="28" font-size="9.5" letter-spacing="0.14em" fill="var(--faint)">AS PUBLISHED</text>
    <g fill="var(--faint)" opacity="0.42">
      <rect x="20" y="44" width="150" height="10" rx="5" />
      <rect x="20" y="62" width="168" height="10" rx="5" />
      <rect x="20" y="80" width="132" height="10" rx="5" />
      <rect x="20" y="98" width="160" height="10" rx="5" />
      <rect x="20" y="116" width="118" height="10" rx="5" />
      <rect x="20" y="134" width="96" height="10" rx="5" />
    </g>
    <text x="20" y="168" font-size="11" font-style="italic" font-family={SERIF} fill="var(--faint)">12 pages · 40 citations</text>

    <line x1="190" y1="96" x2="214" y2="96" stroke="var(--accent)" stroke-width="2" marker-end="url(#arr-brown)" />

    <text x="226" y="28" font-size="9.5" letter-spacing="0.14em" fill="var(--faint)">AS UNDERSTOOD</text>
    <text x="226" y="88" font-size="12.5" font-style="italic" font-family={SERIF} fill="var(--ink)">Your brain mistakes</text>
    <text x="226" y="110" font-size="12.5" font-style="italic" font-family={SERIF} fill="var(--ink)">a deadline for a threat.</text>
    <text x="226" y="140" font-size="11" font-style="italic" font-family={SERIF} fill="var(--faint)">one sentence.</text>
  </svg>
)}

{id === "studio-2511" && (
  <svg viewBox="0 0 380 210" role="img" aria-label="Diagram: one shape with two motion paths — a scribble going nowhere and a purposeful arrow">
    <defs>
      <marker id="arr-brown-2" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" fill="var(--accent)" />
      </marker>
    </defs>

    <text x="190" y="28" text-anchor="middle" font-size="9.5" letter-spacing="0.14em" fill="var(--faint)">TWO KINDS OF MOTION</text>

    <circle cx="60" cy="105" r="14" fill="none" stroke="var(--ink)" stroke-width="1.5" />

    <path d="M76,108 C100,70 120,140 150,110 S190,80 210,115 S250,140 268,118"
      fill="none" stroke="var(--faint)" stroke-width="1.25" stroke-linecap="round" />
    <circle cx="268" cy="118" r="2" fill="var(--faint)" opacity="0.6" />
    <text x="148" y="188" font-size="12.5" font-style="italic" font-family={SERIF} fill="var(--faint)">moves, says nothing</text>

    <path d="M76,102 C140,100 180,60 240,62 C270,63 288,80 300,92"
      fill="none" stroke="var(--accent)" stroke-width="2" stroke-dasharray="5 4" stroke-linecap="round" marker-end="url(#arr-brown-2)" />
    <rect x="302" y="88" width="28" height="28" fill="none" stroke="var(--ink)" stroke-width="1.5" />
    <circle r="4" fill="var(--accent)">
      <animateMotion dur="2.8s" repeatCount="indefinite" path="M76,102 C140,100 180,60 240,62 C270,63 288,80 300,92" />
    </circle>
    <text x="255" y="46" font-size="12.5" font-style="italic" font-family={SERIF} fill="var(--muted)">moves, means something</text>
  </svg>
)}

{id === "brainrotco" && (
  <svg viewBox="0 0 380 220" role="img" aria-label="Diagram: one moving shape among static ones draws the eye">
    <g fill="none" stroke="var(--faint)" stroke-width="1.5" opacity="0.55">
      <circle cx="52" cy="44" r="7" />
      <rect x="104" y="36" width="15" height="15" />
      <path d="M156,52 L164,36 L172,52 Z" />
      <circle cx="224" cy="42" r="7" />
      <rect x="292" y="36" width="15" height="15" />
      <path d="M340,52 L348,36 L356,52 Z" />
      <circle cx="64" cy="104" r="7" />
      <rect x="120" y="96" width="15" height="15" />
      <circle cx="330" cy="104" r="7" />
      <path d="M100,178 L108,162 L116,178 Z" />
      <circle cx="170" cy="170" r="7" />
      <rect x="300" y="162" width="15" height="15" />
    </g>

    <g fill="none" stroke="var(--accent)" stroke-linecap="round">
      <path d="M194,94 q-26,24 0,48" stroke-width="1.5" opacity="0.35" />
      <path d="M204,100 q-20,18 0,36" stroke-width="1.5" opacity="0.55" />
      <path d="M214,106 q-14,12 0,24" stroke-width="1.5" opacity="0.8" />
    </g>
    <circle cx="240" cy="118" r="11" fill="none" stroke="var(--accent)" stroke-width="2.25" />

    <text x="52" y="206" font-size="13" font-style="italic" font-family={SERIF} fill="var(--muted)">your eye goes here</text>
    <path d="M180,198 C205,180 215,160 226,140" fill="none" stroke="var(--faint)" stroke-width="1.25" />
  </svg>
)}
