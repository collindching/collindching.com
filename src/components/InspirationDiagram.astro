---
// Hand-built diagram per inspiration entry, in the vein of The Brain Lab Co:
// metaphor-first, contrast-driven, annotated — not boxes-and-arrows.
//
// Anti-AI-tell rules: nothing centered-and-even, labels annotate instead of
// titling, color encodes meaning (brown = the human intervention,
// faint = raw noise), every mark earns its place.
interface Props {
  id: string;
}
const { id } = Astro.props;
const SERIF = "Georgia, 'Times New Roman', serif";
---

{id === "brain-lab" && (
  <svg viewBox="0 0 380 190" role="img" aria-label="Diagram: a dense paper contrasted with its one-sentence translation">
    <defs>
      <marker id="arr-brown" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" fill="var(--accent)" />
      </marker>
    </defs>

    <text x="20" y="28" font-size="9.5" letter-spacing="0.14em" fill="var(--faint)">AS PUBLISHED</text>
    <g fill="var(--faint)" opacity="0.42">
      <rect x="20" y="44" width="150" height="10" rx="5" />
      <rect x="20" y="62" width="168" height="10" rx="5" />
      <rect x="20" y="80" width="132" height="10" rx="5" />
      <rect x="20" y="98" width="160" height="10" rx="5" />
      <rect x="20" y="116" width="118" height="10" rx="5" />
      <rect x="20" y="134" width="96" height="10" rx="5" />
    </g>
    <text x="20" y="168" font-size="11" font-style="italic" font-family={SERIF} fill="var(--faint)">12 pages · 40 citations</text>

    <line x1="190" y1="96" x2="214" y2="96" stroke="var(--accent)" stroke-width="2" marker-end="url(#arr-brown)" />

    <text x="226" y="28" font-size="9.5" letter-spacing="0.14em" fill="var(--faint)">AS UNDERSTOOD</text>
    <text x="226" y="88" font-size="12.5" font-style="italic" font-family={SERIF} fill="var(--ink)">Your brain mistakes</text>
    <text x="226" y="110" font-size="12.5" font-style="italic" font-family={SERIF} fill="var(--ink)">a deadline for a threat.</text>
    <text x="226" y="140" font-size="11" font-style="italic" font-family={SERIF} fill="var(--faint)">one sentence.</text>
  </svg>
)}

{id === "studio-2511" && (
  <svg viewBox="0 0 380 210" role="img" aria-label="Diagram: one shape with two motion paths — a scribble going nowhere and a purposeful arrow">
    <defs>
      <marker id="arr-brown-2" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" fill="var(--accent)" />
      </marker>
    </defs>

    <text x="190" y="28" text-anchor="middle" font-size="9.5" letter-spacing="0.14em" fill="var(--faint)">TWO KINDS OF MOTION</text>

    <circle cx="60" cy="105" r="14" fill="none" stroke="var(--ink)" stroke-width="1.5" />

    <path d="M76,108 C100,70 120,140 150,110 S190,80 210,115 S250,140 268,118"
      fill="none" stroke="var(--faint)" stroke-width="1.25" stroke-linecap="round" />
    <circle cx="268" cy="118" r="2" fill="var(--faint)" opacity="0.6" />
    <text x="148" y="188" font-size="12.5" font-style="italic" font-family={SERIF} fill="var(--faint)">moves, says nothing</text>

    <path d="M76,102 C140,100 180,60 240,62 C270,63 288,80 300,92"
      fill="none" stroke="var(--accent)" stroke-width="2" stroke-dasharray="5 4" stroke-linecap="round" marker-end="url(#arr-brown-2)" />
    <rect x="302" y="88" width="28" height="28" fill="none" stroke="var(--ink)" stroke-width="1.5" />
    <circle r="4" fill="var(--accent)">
      <animateMotion dur="2.8s" repeatCount="indefinite" path="M76,102 C140,100 180,60 240,62 C270,63 288,80 300,92" />
    </circle>
    <text x="255" y="46" font-size="12.5" font-style="italic" font-family={SERIF} fill="var(--muted)">moves, means something</text>
  </svg>
)}

{id === "brainrotco" && (
  <svg viewBox="0 0 380 220" role="img" aria-label="Diagram: one moving shape among static ones draws the eye">
    <g fill="none" stroke="var(--faint)" stroke-width="1.5" opacity="0.55">
      <circle cx="52" cy="44" r="7" />
      <rect x="104" y="36" width="15" height="15" />
      <path d="M156,52 L164,36 L172,52 Z" />
      <circle cx="224" cy="42" r="7" />
      <rect x="292" y="36" width="15" height="15" />
      <path d="M340,52 L348,36 L356,52 Z" />
      <circle cx="64" cy="104" r="7" />
      <rect x="120" y="96" width="15" height="15" />
      <circle cx="330" cy="104" r="7" />
      <path d="M100,178 L108,162 L116,178 Z" />
      <circle cx="170" cy="170" r="7" />
      <rect x="300" y="162" width="15" height="15" />
    </g>

    <g>
      <animateTransform attributeName="transform" type="translate"
        values="0 0; -5 1; 5 -1; 0 0; 0 0" keyTimes="0; 0.08; 0.16; 0.28; 1"
        dur="2.6s" repeatCount="indefinite" />
      <g fill="none" stroke="var(--accent)" stroke-linecap="round">
        <path d="M194,94 q-26,24 0,48" stroke-width="1.5" opacity="0.35" />
        <path d="M204,100 q-20,18 0,36" stroke-width="1.5" opacity="0.55" />
        <path d="M214,106 q-14,12 0,24" stroke-width="1.5" opacity="0.8" />
      </g>
      <circle cx="240" cy="118" r="11" fill="none" stroke="var(--accent)" stroke-width="2.25" />
    </g>

    <text x="52" y="206" font-size="13" font-style="italic" font-family={SERIF} fill="var(--muted)">you looked here first</text>
    <path d="M180,198 C205,180 215,160 226,140" fill="none" stroke="var(--faint)" stroke-width="1.25" />
  </svg>
)}

{id === "qoves" && (
  <svg viewBox="0 0 380 276" role="img" aria-label="Diagram: many faint faces pass through one measuring lens and emerge as a single annotated reveal">
    <defs>
      <marker id="arr-brown-3" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" fill="var(--accent)" />
      </marker>
    </defs>

    <text x="20" y="28" font-size="9.5" letter-spacing="0.14em" fill="var(--faint)">INFINITE SUBJECTS</text>
    <g fill="none" stroke="var(--faint)" stroke-width="1.5" opacity="0.5">
      <ellipse cx="48" cy="96" rx="20" ry="28" />
      <ellipse cx="106" cy="93" rx="24" ry="31" />
      <ellipse cx="162" cy="97" rx="19" ry="27" />
    </g>

    <text x="192" y="70" font-size="9.5" letter-spacing="0.14em" fill="var(--faint)">ONE LENS</text>
    <line x1="196" y1="95" x2="226" y2="95" stroke="var(--accent)" stroke-width="2" marker-end="url(#arr-brown-3)" />

    <text x="252" y="28" font-size="9.5" letter-spacing="0.14em" fill="var(--faint)">THE REVEAL</text>
    <ellipse cx="304" cy="95" rx="26" ry="34" fill="none" stroke="var(--ink)" stroke-width="1.5" />
    <g stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round">
      <line x1="278" y1="86" x2="330" y2="86" />
      <line x1="278" y1="82" x2="278" y2="90" />
      <line x1="330" y1="82" x2="330" y2="90" />
      <line x1="342" y1="61" x2="342" y2="129" />
      <line x1="338" y1="61" x2="346" y2="61" />
      <line x1="338" y1="129" x2="346" y2="129" />
      <line x1="339" y1="84" x2="345" y2="84" opacity="0.7" />
      <line x1="339" y1="106" x2="345" y2="106" opacity="0.7" />
    </g>
    <text x="304" y="150" text-anchor="middle" font-size="10.5" font-style="italic" font-family={SERIF} fill="var(--accent)">1 : 1.618</text>

    <text x="252" y="172" font-size="12.5" font-style="italic" font-family={SERIF} fill="var(--ink)">the hidden ratio,</text>
    <text x="252" y="190" font-size="12.5" font-style="italic" font-family={SERIF} fill="var(--ink)">made visible.</text>

    <text x="20" y="212" font-size="9.5" letter-spacing="0.14em" fill="var(--faint)">THE LADDER</text>
    <text x="20" y="230" font-size="12.5" font-style="italic" font-family={SERIF} fill="var(--muted)">every reveal sells <tspan fill="var(--accent)">your personal analysis</tspan></text>
    <text x="20" y="252" font-size="11" font-style="italic" font-family={SERIF} fill="var(--faint)">the subject is the fuel:</text>
    <text x="20" y="266" font-size="11" font-style="italic" font-family={SERIF} fill="var(--faint)">your face pulls harder than 3Blue1Brown’s math.</text>
  </svg>
)}

{id === "alena" && (
  <svg viewBox="0 0 380 244" role="img" aria-label="Diagram: five identical gray squares pass through a critique and emerge as four quiet squares and one large brown square">
    <defs>
      <marker id="arr-brown-4" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" fill="var(--accent)" />
      </marker>
    </defs>

    <text x="20" y="26" font-size="9.5" letter-spacing="0.14em" fill="var(--faint)">BEFORE</text>
    <g fill="var(--faint)" opacity="0.45">
      <rect x="20" y="44" width="36" height="36" rx="6" />
      <rect x="68" y="44" width="36" height="36" rx="6" />
      <rect x="116" y="44" width="36" height="36" rx="6" />
      <rect x="164" y="44" width="36" height="36" rx="6" />
      <rect x="212" y="44" width="36" height="36" rx="6" />
    </g>
    <text x="268" y="66" font-size="11" font-style="italic" font-family={SERIF} fill="var(--faint)">everything at</text>
    <text x="268" y="82" font-size="11" font-style="italic" font-family={SERIF} fill="var(--faint)">the same volume</text>

    <line x1="130" y1="96" x2="130" y2="120" stroke="var(--accent)" stroke-width="2" marker-end="url(#arr-brown-4)" />

    <text x="20" y="144" font-size="9.5" letter-spacing="0.14em" fill="var(--faint)">AFTER</text>
    <g fill="var(--faint)" opacity="0.45">
      <rect x="20" y="160" width="36" height="36" rx="6" />
      <rect x="68" y="160" width="36" height="36" rx="6" />
      <rect x="164" y="160" width="36" height="36" rx="6" />
      <rect x="212" y="160" width="36" height="36" rx="6" />
    </g>
    <rect x="106" y="148" width="60" height="60" rx="8" fill="var(--accent)" />
    <text x="268" y="182" font-size="12.5" font-style="italic" font-family={SERIF} fill="var(--accent)">one brave choice</text>
    <path d="M262,176 C240,172 220,172 200,176" fill="none" stroke="var(--faint)" stroke-width="1.25" />

    <text x="20" y="232" font-size="12.5" font-style="italic" font-family={SERIF} fill="var(--muted)">boring is everything at the same volume.</text>
  </svg>
)}
