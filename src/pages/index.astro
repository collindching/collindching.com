---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { readingList } from "../data/reading";
import { SITE_DESCRIPTION } from "../consts";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const reads = [...readingList]
  .sort((a, b) => b.added.localeCompare(a.added))
  .slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<style>
  .statement {
    margin: var(--space-6) 0 var(--space-2);
    max-width: 40rem;
  }
  .statement h1 {
    font-size: clamp(1.65rem, 4vw, 2.4rem);
    margin: 0 0 var(--space-2);
  }
  .statement p {
    color: var(--muted);
    font-size: 1.05rem;
    margin: 0;
  }
  .kicker {
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    color: var(--faint);
    margin-bottom: var(--space-2);
  }
  .featured {
    border-left: 3px solid var(--accent);
    background: var(--accent-soft);
    border-radius: 0 8px 8px 0;
    padding: var(--space-3) var(--space-4);
    margin: var(--space-5) 0;
  }
  .featured .kicker {
    color: var(--accent);
  }
  .featured p {
    margin-bottom: var(--space-2);
  }
  .featured p:last-child {
    margin-bottom: 0;
  }
</style>

<Base description={SITE_DESCRIPTION}>
  <div class="statement">
    <h1>A data scientist learning entrepreneurship with AI.</h1>
    <p>
      The proof is the work. Every week: read something real, write it up,
      build it into this site.
    </p>
  </div>

  <div class="featured">
    <p class="kicker">THIS WEEK</p>
    <p>
      <strong>The first public teardown.</strong> A landing page dissected
      surgeon-style — the leak, the ranked fixes, one stealable principle.
      Shipping Monday.
    </p>
    <p><a href="/projects">All projects →</a></p>
  </div>

  <div class="section-head">
    <h2>Writing</h2>
    <a href="/writing">All posts →</a>
  </div>
  <ul class="post-list">
    {
      posts.map((post) => (
        <li class="reveal">
          <a class="post-title" href={`/writing/${post.id}`}>
            {post.data.title}
          </a>
          <p class="post-meta">{fmt(post.data.pubDate)}</p>
          <p class="post-desc">{post.data.description}</p>
        </li>
      ))
    }
  </ul>

  <div class="section-head">
    <h2>Reading</h2>
    <a href="/reading">All reading →</a>
  </div>
  <ul class="post-list">
    {
      reads.map((item) => (
        <li class="reveal">
          <a class="post-title" href={item.url}>
            {item.title}
          </a>
          <p class="post-meta">
            {item.author} · {item.kind} · added {item.added}
          </p>
          <p class="post-desc">{item.note}</p>
        </li>
      ))
    }
  </ul>
</Base>
